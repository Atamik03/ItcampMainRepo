# Copy this file to `.env` (already gitignored) -- ./start.sh / start.ps1 do
# this for you automatically if `.env` doesn't exist yet.
#
# Real secrets (POSTGRES_PASSWORD, REDIS_PASSWORD, ELOU_AUTH_SECRET) are NOT
# here anymore -- they live in ./secrets/*.txt as Docker Secrets, generated
# by ./start.sh / start.ps1, and are never read from the environment or this
# file. Only non-sensitive configuration belongs in `.env`.

# ---- Postgres (db / docker-bd) ----
# Username/DB name are not secret -- only the password is (see ./secrets/).
POSTGRES_USER=elou_avt
POSTGRES_DB=elou_avt

# ---- Backend (docker-beck) ----
ELOU_ENV=production
ELOU_AUTH_MODE=enabled
# Comma-separated list of origins allowed to call the API cross-origin.
ELOU_CORS_ORIGINS=http://localhost:8080
